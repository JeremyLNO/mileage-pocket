<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CarPlay Driving Task. Granted by Apple on 2026-09-14 and enabled on the App ID, so the
	  provisioning profile carries it; see docs/CARPLAY-ENTITLEMENT.md.
	-->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
	<!--
	  iCloud (com.apple.developer.icloud-*) and the App Group are intentionally absent from
	  this build.

	  Creating an App Group identifier and a CloudKit container is not possible through the
	  App Store Connect API — only the developer portal or a Xcode signed in with an Apple
	  account can do it, and this machine has neither. The provisioning profile therefore
	  authorises those capabilities with *empty* lists, and naming a container the profile
	  does not grant fails code signing outright.

	  The app already handles their absence: the store falls back to a local one
	  (PersistenceController.makeContainerWithFallback) and the widget simply shows its
	  button without the month's figures. Re-add both keys as soon as the group
	  `group.company.lno.mileage` and the container `iCloud.company.lno.mileage` exist.
	-->
</dict>
</plist>
