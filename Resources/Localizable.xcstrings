    "onboarding.country.custom": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Land ist keine offizielle Pauschale hinterlegt. Du legst deinen eigenen Satz fest, alles andere bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No official scale is built in for this country. You will set your own rate, and everything else works the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un baremo oficial integrado para este país. Definirás tu propia tarifa y todo lo demás funciona igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun barème officiel n’est intégré pour ce pays. Vous définirez votre propre taux, tout le reste fonctionne pareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo paese non è inclusa una tabella ufficiale. Imposterai la tua tariffa e tutto il resto funziona uguale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe uma tabela oficial integrada para este país. Vais definir a tua própria taxa e tudo o resto funciona igual."
          }
        }
      }
    },
    "onboarding.country.official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An official mileage scale is built in for %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
