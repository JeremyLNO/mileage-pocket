    "onboarding.location.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Standorte bleiben auf deinem iPhone und in deiner iCloud. Sie werden nie verkauft, geteilt oder an Werbetreibende weitergegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your positions stay on your iPhone and in your own iCloud. They are never sold, shared or sent to an advertiser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus posiciones se quedan en tu iPhone y en tu iCloud. Nunca se venden, se comparten ni se envían a un anunciante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos positions restent sur votre iPhone et dans votre iCloud. Elles ne sont jamais vendues, partagées ni transmises à un annonceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue posizioni restano sul tuo iPhone e nel tuo iCloud. Non vengono mai vendute, condivise né inviate a un inserzionista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas posições ficam no teu iPhone e no teu iCloud. Nunca são vendidas, partilhadas nem enviadas a anunciantes."
          }
        }
      }
    },
    "onboarding.location.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Standortzugriff werden deine Kilometer auch bei gesperrtem iPhone berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access lets the app calculate your mileage even when your iPhone is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación permite calcular tus kilómetros aunque el iPhone esté bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position permet de calculer vos kilomètres même quand votre iPhone est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla posizione permette di calcolare i chilometri anche con l’iPhone bloccato."
