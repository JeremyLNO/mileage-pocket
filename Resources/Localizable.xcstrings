    "pdf.footer.custom.rate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht verwendet einen von dir selbst festgelegten Satz, keine offiziell veröffentlichte Tabelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report uses a rate you configured yourself, not an official published scale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe utiliza una tarifa configurada por ti, no un baremo oficial publicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
