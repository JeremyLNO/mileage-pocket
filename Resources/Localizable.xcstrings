    "settings.export.all.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete archive of your records, in a machine-readable format. Formatted PDF and CSV reports are part of the subscription."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une archive complète de vos données, dans un format exploitable par une machine. Les rapports PDF et CSV mis en forme font partie de l'abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo completo de tus datos, en un formato legible por máquina. Los informes PDF y CSV con formato forman parte de la suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vollständiges Archiv deiner Daten in maschinenlesbarer Form. Aufbereitete PDF- und CSV-Berichte gehören zum Abo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivio completo dei tuoi dati, in un formato leggibile da una macchina. I report PDF e CSV formattati fanno parte dell'abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo completo dos seus dados, num formato legível por máquina. Os relatórios PDF e CSV formatados fazem parte da subscrição."
          }
        }
      }
    },
