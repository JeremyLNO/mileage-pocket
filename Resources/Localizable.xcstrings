    "detail.recalculate.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der mit dieser Fahrt gespeicherte Kilometersatz wird durch den heute gültigen ersetzt. Ältere Fahrten behalten normalerweise den Satz, der am Tag der Fahrt galt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the rate saved with this trip by the one in force today. Older trips normally keep the rate that applied when you drove them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarifa guardada con este viaje se sustituye por la vigente hoy. Normalmente, un viaje antiguo conserva la tarifa que se aplicaba cuando lo hiciste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le taux enregistré avec ce trajet est remplacé par celui en vigueur aujourd’hui. En principe, un trajet ancien garde le taux applicable au moment où il a été effectué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tariffa salvata con questo viaggio viene sostituita da quella in vigore oggi. Di norma, un viaggio passato mantiene la tariffa valida nel giorno in cui è stato fatto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa guardada com esta viagem é substituída pela que está em vigor hoje. Normalmente, uma viagem antiga mantém a taxa aplicável na data em que foi feita."
          }
        }
      }
    },
