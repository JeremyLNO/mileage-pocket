    "vehicle.engine.capacity.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kilometerpauschale deines Landes richtet sich nach dem Hubraum. Er steht in deinem Fahrzeugschein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country's mileage scale uses engine capacity. It is printed on your registration document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El baremo de kilometraje de tu país usa la cilindrada. Aparece en el permiso de circulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barème kilométrique de votre pays utilise la cylindrée. Elle figure sur votre carte grise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella chilometrica del tuo paese usa la cilindrata. È indicata sul libretto di circolazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela de quilometragem do teu país usa a cilindrada. Está indicada no documento único automóvel."
          }
        }
      }
    },
