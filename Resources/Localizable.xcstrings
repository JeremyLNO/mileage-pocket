    "activetrip.stop.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung läuft weiter und nichts ist verloren. Schaffe Speicherplatz auf deinem iPhone und tippe erneut auf Stopp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is still running and nothing has been lost. Free up some space on your iPhone, then press Stop again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación sigue en marcha y no se ha perdido nada. Libera espacio en tu iPhone y vuelve a pulsar Detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement continue et rien n'est perdu. Libérez de l'espace sur votre iPhone, puis appuyez à nouveau sur Arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è ancora in corso e non è andato perso nulla. Libera spazio sul tuo iPhone, poi premi di nuovo Termina."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação continua e nada foi perdido. Liberte espaço no seu iPhone e prima novamente Parar."
          }
        }
      }
    },
