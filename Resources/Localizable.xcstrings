    "detail.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trip and its route are removed for good. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce trajet et son tracé sont supprimés définitivement. C'est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viaje y su recorrido se eliminan definitivamente. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fahrt und ihre Strecke werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo viaggio e il suo percorso vengono eliminati definitivamente. L'operazione è irreversibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta viagem e o seu percurso são eliminados definitivamente. Não é possível anular."
          }
        }
      }
    },
