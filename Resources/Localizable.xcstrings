        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung nach drei Stunden, damit eine vergessene Fahrt nicht die ganze Nacht weiterläuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder three hours in, so a trip you forgot to stop does not run all night."
          }
        },
        "es": {
