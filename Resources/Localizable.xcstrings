    "settings.no.official.rule": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Land hat Mileage Pocket keine geprüfte offizielle Pauschale, deshalb gilt dein eigener Satz. Aufzeichnung, Verlauf und Berichte funktionieren genauso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket has no verified official scale for this country, so your own rate is used. Tracking, history and reports work exactly the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket no tiene un baremo oficial verificado para este país, así que se usa tu propia tarifa. El seguimiento, el historial y los informes funcionan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket n’a pas de barème officiel vérifié pour ce pays : c’est votre propre taux qui s’applique. Le suivi, l’historique et les rapports fonctionnent exactement pareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket non ha una tabella ufficiale verificata per questo paese, quindi si usa la tua tariffa. Registrazione, cronologia e report funzionano allo stesso modo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mileage Pocket não tem uma tabela oficial verificada para este país, por isso é usada a tua taxa. O registo, o histórico e os relatórios funcionam da mesma forma."
          }
        }
      }
    },
