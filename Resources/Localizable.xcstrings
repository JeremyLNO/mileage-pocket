    "review.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fahrt, die niemand einordnet, landet trotzdem in der Abrechnung – mit dem Standardwert, welcher auch immer das war. Tippe die Fahrt an, um Kunde oder Zweck zu ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A trip nobody qualifies still goes onto the claim — as whatever the default happened to be. Tap the trip itself to add a client or a purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje que nadie clasifica acaba igualmente en la nota de gastos, con el valor por defecto que hubiera. Toca el viaje para añadir un cliente o un motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trajet que personne ne qualifie part quand même sur la note de frais — avec la valeur par défaut, quelle qu'elle soit. Touchez le trajet pour ajouter un client ou un motif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaggio che nessuno classifica finisce comunque nella nota spese, con il valore predefinito qualunque esso sia. Tocca il viaggio per aggiungere un cliente o un motivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma viagem que ninguém classifica vai à mesma para a nota de despesas — com o valor predefinido, seja ele qual for. Toque na viagem para juntar um cliente ou um motivo."
          }
        }
      }
    },
