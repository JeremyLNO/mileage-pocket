          }
        }
      }
    },
    "pdf.footer.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet mit dem in Mileage Pocket konfigurierten Kilometersatz. Prüfe die Anrechenbarkeit nach deinem lokalen Steuerrecht. Dieses Dokument ist keine zertifizierte Steuerbescheinigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated using the applicable mileage rate configured in Mileage Pocket. Verify eligibility according to your local tax regulations. This document is not a certified tax statement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado con la tarifa kilométrica configurada en Mileage Pocket. Verifica la elegibilidad según tu normativa fiscal local. Este documento no es un certificado fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé à partir du barème kilométrique configuré dans Mileage Pocket. Vérifiez l'éligibilité au regard de votre réglementation fiscale locale. Ce document n'est pas une attestation fiscale certifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato con la tariffa chilometrica configurata in Mileage Pocket. Verifica l'ammissibilità secondo la normativa fiscale locale. Questo documento non è una certificazione fiscale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado com a taxa por quilómetro configurada no Mileage Pocket. Verifique a elegibilidade de acordo com a sua legislação fiscal local. Este documento não é uma declaração fiscal certificada."
          }
        }
      }
    },
