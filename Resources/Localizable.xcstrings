    "store.ephemeral.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher ist nicht verfügbar. Alles, was jetzt aufgezeichnet wird, geht beim Schließen der App verloren. Schaffe Speicherplatz auf deinem iPhone und starte Mileage Pocket neu, bevor du losfährst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage is unavailable, so anything recorded now will be lost when you close the app. Free up space on your iPhone and relaunch Mileage Pocket before driving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento no está disponible, así que todo lo que se registre ahora se perderá al cerrar la app. Libera espacio en tu iPhone y vuelve a abrir Mileage Pocket antes de conducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage est indisponible : tout ce qui sera enregistré maintenant sera perdu à la fermeture de l'app. Libérez de l'espace sur votre iPhone et relancez Mileage Pocket avant de prendre la route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archiviazione non è disponibile: tutto ciò che viene registrato ora andrà perso alla chiusura dell'app. Libera spazio sul tuo iPhone e riapri Mileage Pocket prima di metterti alla guida."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento está indisponível, pelo que tudo o que for registado agora será perdido ao fechar a app. Liberte espaço no seu iPhone e reabra o Mileage Pocket antes de conduzir."
          }
        }
      }
    },
    "store.ephemeral.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrten werden nicht gespeichert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips will not be saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los viajes no se guardarán"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trajets ne seront pas enregistrés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I viaggi non verranno salvati"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As viagens não serão guardadas"
          }
        }
      }
    },
    "store.recovered.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket wurde mit einer leeren Datenbank gestartet. Die vorherige wurde auf deinem Gerät behalten und nichts wurde gelöscht – wende dich an den Support, sie kann wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket started with an empty database. The previous one was kept on your device and nothing was deleted — contact support and it can be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket se ha iniciado con una base de datos vacía. La anterior se ha conservado en tu dispositivo y no se ha borrado nada: contacta con soporte y podrá recuperarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket a démarré avec une base vide. La précédente a été conservée sur votre appareil et rien n'a été supprimé — contactez le support, elle peut être récupérée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket è stato avviato con un database vuoto. Quello precedente è stato conservato sul dispositivo e non è stato eliminato nulla: contatta l'assistenza, può essere recuperato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mileage Pocket arrancou com uma base de dados vazia. A anterior foi mantida no seu dispositivo e nada foi apagado — contacte o suporte e poderá ser recuperada."
          }
        }
      }
    },
    "store.recovered.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten konnten nicht geöffnet werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
