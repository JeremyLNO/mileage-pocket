    "review.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede aufgezeichnete Fahrt wurde als geschäftlich oder privat eingeordnet. Es wartet nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every recorded trip has been said to be business or personal. Nothing is waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada viaje registrado se ha declarado profesional o personal. No queda nada pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trajet enregistré a été déclaré professionnel ou personnel. Rien n'attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni viaggio registrato è stato dichiarato di lavoro o personale. Non c'è nulla in attesa."
          }
