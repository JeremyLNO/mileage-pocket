    "pdf.footer.mixed.currency": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Dieser Zeitraum enthält Fahrten in mehreren Währungen (%@). Jede Währung wird separat summiert; sie werden nicht addiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: this period contains trips priced in more than one currency (%@). Each currency is totalled separately; they are not added together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: este periodo contiene viajes valorados en más de una moneda (%@). Cada moneda se totaliza por separado; no se suman entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note : cette période contient des trajets valorisés dans plusieurs devises (%@). Chaque devise est totalisée séparément ; elles ne sont pas additionnées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: questo periodo contiene viaggi valorizzati in più valute (%@). Ogni valuta è totalizzata separatamente; non vengono sommate tra loro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: este período contém viagens valorizadas em mais do que uma moeda (%@). Cada moeda é totalizada separadamente; não são somadas entre si."
          }
        }
      }
    },
    "pdf.footer.mixed.versions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: In diesem Zeitraum gelten mehrere Versionen des Regelwerks (%@). Jede Fahrt behält den an ihrem Datum gültigen Satz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: more than one rule version applies inside this period (%@). Each trip keeps the rate in force on its own date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: en este periodo se aplican varias versiones del baremo (%@). Cada viaje conserva la tarifa vigente en su propia fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note : plusieurs versions du barème s'appliquent sur cette période (%@). Chaque trajet conserve le taux en vigueur à sa date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: in questo periodo si applicano più versioni del tariffario (%@). Ogni viaggio mantiene la tariffa in vigore alla propria data."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
