    "home.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf START, wenn du losfährst. Deine erste Fahrt ist nur einen Fingertipp entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press START when you set off. Your first mileage record is one tap away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa INICIAR cuando salgas. Tu primer registro de kilometraje está a un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur START quand vous partez. Votre premier relevé kilométrique ne prend qu’un geste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca AVVIA quando parti. Il tuo primo viaggio è a un tocco di distanza."
