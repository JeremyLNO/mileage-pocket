    "vehicle.fiscal.horsepower.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kilometerpauschale deines Landes richtet sich nach den Steuer-PS. Sie stehen in deinem Fahrzeugschein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your country's mileage scale uses fiscal horsepower. It is printed on your registration document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El baremo de kilometraje de tu país usa la potencia fiscal. Aparece en el permiso de circulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barème kilométrique de votre pays utilise les chevaux fiscaux. Ils figurent sur votre carte grise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabella chilometrica del tuo paese usa i cavalli fiscali. Sono indicati sul libretto di circolazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabela de quilometragem do teu país usa os cavalos fiscais. Estão indicados no documento único automóvel."
          }
        }
      }
