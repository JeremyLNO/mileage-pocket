    "detail.edit.distance.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgezeichnete Strecke bleibt erhalten. Der Betrag wird mit dem Kilometersatz neu berechnet, der für diese Fahrt bereits gilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded distance is kept. The amount is recalculated with the rate already applied to this trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva la distancia registrada. El importe se recalcula con la tarifa ya aplicada a este viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance enregistrée est conservée. Le montant est recalculé avec le taux déjà appliqué à ce trajet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza registrata resta invariata. L’importo viene ricalcolato con la tariffa già applicata a questo viaggio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância registada mantém-se. O valor é recalculado com a taxa já aplicada a esta viagem."
          }
        }
      }
    },
