    "carplay.needs.always.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sie am iPhone auf „Immer\" – sonst zeichnet eine im Auto gestartete Fahrt nichts auf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set it to Always on your iPhone — a trip started from the car records nothing without it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámbiala a «Siempre» en tu iPhone: sin eso, un viaje iniciado desde el coche no registra nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez-la sur « Toujours » sur votre iPhone — sans cela, un trajet lancé depuis la voiture n'enregistre rien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostala su «Sempre» sul tuo iPhone: senza, un viaggio avviato dall'auto non registra nulla"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina-a como «Sempre» no seu iPhone — sem isso, uma viagem iniciada a partir do carro não regista nada"
          }
        }
      }
    },
