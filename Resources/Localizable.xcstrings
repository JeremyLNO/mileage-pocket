    "settings.delete.all.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Fahrten, Fahrzeuge und Kunden werden von diesem iPhone und aus iCloud gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every trip, vehicle and client is removed from this iPhone and from iCloud. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan todos los viajes, vehículos y clientes de este iPhone y de iCloud. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les trajets, véhicules et clients sont supprimés de cet iPhone et d’iCloud. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i viaggi, i veicoli e i clienti vengono eliminati da questo iPhone e da iCloud. L’operazione è irreversibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as viagens, veículos e clientes são apagados deste iPhone e do iCloud. Não é possível anular."
          }
        }
      }
    },
