          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se incluye un baremo kilométrico oficial para %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ ist eine offizielle Kilometerpauschale hinterlegt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %@ è incluso un rimborso chilometrico ufficiale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está incluída uma tabela oficial de quilometragem para %@."
          }
        }
      }
    },
    "onboarding.country.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das legt deine Währung, deine Einheiten und die Kilometerpauschale für deine Fahrten fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sets your currency, your units and the mileage rule applied to your trips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define tu moneda, tus unidades y el baremo de kilometraje que se aplica a tus viajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela détermine votre devise, vos unités et le barème kilométrique appliqué à vos trajets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
