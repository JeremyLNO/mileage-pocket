    "vehicles.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das Auto hinzu, mit dem du für die Arbeit fährst. Fahrten lassen sich auch ohne aufzeichnen, aber die Berichte werden damit klarer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the car you drive for work. You can record trips without one, but reports read better with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el coche que usas para trabajar. Puedes registrar viajes sin él, pero los informes quedan más claros con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la voiture que vous utilisez pour le travail. Les trajets fonctionnent sans, mais les rapports sont plus clairs avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi l’auto che usi per lavoro. Puoi registrare i viaggi anche senza, ma i report sono più chiari indicandola."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona o carro que usas para trabalhar. Podes registar viagens sem ele, mas os relatórios ficam mais claros com ele."
          }
        }
      }
    },
