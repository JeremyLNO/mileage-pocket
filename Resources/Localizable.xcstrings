    "onboarding.notifications.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, wenn eine Fahrt noch läuft, und ein Hinweis, wenn sich der Monatsbericht lohnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder if a trip is still running, and a nudge when your monthly report is worth generating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso si un viaje sigue en curso y otro cuando toca generar el informe mensual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel si un trajet tourne encore, et un signal quand votre rapport mensuel vaut le coup."
