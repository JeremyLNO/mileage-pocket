    "home.location.refused.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket cannot measure a trip without location access. Turn it on in Settings to start recording."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket ne peut pas mesurer un trajet sans accès à la localisation. Activez-le dans Réglages pour enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mileage Pocket no puede medir un viaje sin acceso a la ubicación. Actívalo en Ajustes para empezar a registrar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Ortungszugriff kann Mileage Pocket keine Fahrt messen. Aktiviere ihn in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
