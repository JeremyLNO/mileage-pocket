    "clients.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrten behalten ihren Verlauf; sie sind lediglich nicht mehr diesem Kunden zugeordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trips keep their history; they simply stop being attached to this client."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los viajes conservan su historial; simplemente dejan de estar asociados a este cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trajets conservent leur historique ; ils ne sont simplement plus rattachés à ce client."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I viaggi mantengono la loro cronologia; semplicemente non sono più associati a questo cliente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As viagens mantêm o seu histórico; deixam apenas de estar associadas a este cliente."
          }
        }
      }
    },
    "clients.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne bei einer Fahrt einen Kunden, und er erscheint hier – bereit zur Wiederverwendung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a client on a trip and it appears here, ready to reuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un cliente en un viaje y aparecerá aquí, listo para reutilizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un client sur un trajet et il apparaît ici, prêt à être réutilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un cliente su un viaggio e comparirà qui, pronto da riutilizzare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique um cliente numa viagem e ele aparece aqui, pronto a reutilizar."
          }
        }
      }
    },
