    "settings.carplay.always.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS liefert einer im Auto gestarteten App nur dann Positionen, wenn die Ortung auf „Immer\" steht. Bei „Beim Verwenden\" läuft bei einer über CarPlay gestarteten Fahrt nur die Uhr, und es wird keine Strecke aufgezeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only delivers positions to an app started from the car when location is set to Always. On \"While Using\", a trip started from CarPlay runs a timer and records no distance at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo entrega posiciones a una app iniciada desde el coche si la ubicación está en «Siempre». Con «Al usar la app», un viaje iniciado desde CarPlay pone en marcha un cronómetro y no registra ninguna distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne livre les positions à une app lancée depuis la voiture que si la localisation est sur « Toujours ». Sur « Lorsque l'app est active », un trajet lancé depuis CarPlay fait tourner un chrono et n'enregistre aucune distance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fornisce le posizioni a un'app avviata dall'auto solo se la posizione è su «Sempre». Con «Mentre usi l'app», un viaggio avviato da CarPlay fa partire un cronometro e non registra alcuna distanza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS só entrega posições a uma app iniciada a partir do carro se a localização estiver em «Sempre». Com «Ao usar a app», uma viagem iniciada pelo CarPlay põe um cronómetro a correr e não regista qualquer distância."
          }
        }
      }
    },
