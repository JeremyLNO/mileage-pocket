// Shared across configurations.
//
// NOTE: xcconfig treats "//" as a comment delimiter, which silently truncates any
// "https://..." value at the colon — and URL(string: "https:") is non-nil, so nothing
// fails loudly. The "$()" workaround does NOT work. Passing the slashes through a build
// setting does, because substitution happens after comments are stripped: use
// https:$(SLASH)$(SLASH)host/path. Verify in the built Info.plist, not in this file.

SLASH = /
APP_NAME = Mileage Pocket

// Le libellé sous l'icône, et lui seul. La marque reste « Mileage Pocket » partout ailleurs :
// fiche App Store, écran d'accueil de l'app, galerie de widgets, textes d'autorisation.
//
// Pourquoi deux noms : SpringBoard retire les espaces d'un libellé trop large avant de le
// tronquer, et « Mileage Pocket » passe de justesse. Une install TestFlight ajoute une
// pastille orange devant le nom, qui prend cette marge — le même build lit « Mileage Pocket »
// installé par Xcode et « MileagePocket » installé par TestFlight. Un nom court n'a pas de
// marge à perdre.
APP_SHORT_NAME = Mileage
BUNDLE_IDENTIFIER = Mileage.lno.company

APP_STORE_ID = 6811426601
APP_STORE_URL = https:$(SLASH)$(SLASH)apps.apple.com/app/id$(APP_STORE_ID)

PRIVACY_POLICY_URL = https:$(SLASH)$(SLASH)www.crazybeelabs.com/legal/apps
TERMS_URL = https:$(SLASH)$(SLASH)www.crazybeelabs.com/legal/apps
SUPPORT_URL = https:$(SLASH)$(SLASH)crazybeelabs.com/support/
// Endpoint de mise à jour des barèmes — pas encore déployé en V1 : l'échec est silencieux.
RULE_PACK_URL = https:$(SLASH)$(SLASH)www.crazybeelabs.com/api/mileage-rules/v1

// NO while the App Group and the CloudKit container do not exist on the developer portal:
// the provisioning profile authorises iCloud with an empty container list, so naming the
// container fails code signing, and opening a CloudKit store without it crashes at launch.
// Flip to YES in the same commit that re-adds the container to App/MileagePocket.entitlements.
CLOUDKIT_AVAILABLE = NO

DEVELOPMENT_TEAM = 2E6D4Q69QB
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
